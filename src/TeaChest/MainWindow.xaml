<Window x:Class="TeaChest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TeaChest.ViewModels"
        Title="TeaChest"
        Width="1360"
        Height="840"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        Icon="Assets/TeaChest.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,22,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                    <Image Width="36" Height="36" Source="Assets/TeaChest.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TeaChest" Style="{StaticResource H2}" />
                        <TextBlock Text="New PC, same apps" Style="{StaticResource RowSubtext}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,28,0,0">
                    <RadioButton x:Name="CollectNav"
                                 Style="{StaticResource NavRadio}"
                                 Tag="&#xE71D;"
                                 Content="Collect apps"
                                 IsChecked="True"
                                 Checked="CollectNav_Checked" />
                    <RadioButton x:Name="InstallNav"
                                 Style="{StaticResource NavRadio}"
                                 Tag="&#xE896;"
                                 Content="Install apps"
                                 Checked="InstallNav_Checked" />
                    <RadioButton x:Name="NearbyNav"
                                 Style="{StaticResource NavRadio}"
                                 Tag="&#xE701;"
                                 Content="Nearby devices"
                                 Checked="NearbyNav_Checked" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ThemeButton"
                            Style="{StaticResource GhostButton}"
                            Content="Switch theme"
                            HorizontalAlignment="Left"
                            FontSize="13"
                            Padding="8,4"
                            Click="ThemeButton_Click" />
                    <TextBlock x:Name="VersionText"
                               Grid.Column="1"
                               Style="{StaticResource RowSubtext}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                </Grid>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,24,28,0">
                <!-- Collect view -->
                <Grid x:Name="CollectView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Collect apps" Style="{StaticResource H1}" />
                            <TextBlock Text="See what is installed, choose what to keep, and save a portable manifest."
                                       Style="{StaticResource Subtle}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OpenButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Open..."
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanEdit}"
                                    Command="{Binding OpenCommand}" />
                            <Button x:Name="SaveButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Save manifest"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanEdit}"
                                    Command="{Binding SaveCommand}" />
                            <Button x:Name="ScanButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Scan this PC"
                                    Command="{Binding ScanCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- The tally: one quiet line, so the list gets the height the stat cards used to take. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="detected" Style="{StaticResource Subtle}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
                        </StackPanel>
                        <Rectangle Width="1" Margin="18,5" Fill="{DynamicResource BorderStrong}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent}" />
                            <TextBlock Text="selected" Style="{StaticResource Subtle}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
                        </StackPanel>
                        <Rectangle Width="1" Margin="18,5" Fill="{DynamicResource BorderStrong}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding WingetCount}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="WinGet" Style="{StaticResource Subtle}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
                        </StackPanel>
                        <Rectangle Width="1" Margin="18,5" Fill="{DynamicResource BorderStrong}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ManualCount}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="manual" Style="{StaticResource Subtle}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="34,7,12,7"
                                 Tag="Search apps, IDs, categories..." />
                        <TextBlock Text="&#xE721;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}"
                                    Content="Select visible"
                                    Command="{Binding SelectVisibleCommand}"
                                    Padding="10,6" />
                            <Button Style="{StaticResource GhostButton}"
                                    Content="Clear visible"
                                    Command="{Binding ClearVisibleCommand}"
                                    Padding="10,6" />
                            <Button Style="{StaticResource GhostButton}"
                                    Content="Defaults"
                                    Command="{Binding RestoreDefaultsCommand}"
                                    Padding="10,6" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ListBox Style="{StaticResource FilterListBox}"
                                         ItemsSource="{Binding Filters}"
                                         SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                                         DisplayMemberPath="Label"
                                         Margin="9,2,16,0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterItem}">
                                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <DataGrid x:Name="AppsGrid"
                                          Grid.Row="1"
                                          ItemsSource="{Binding AppsView}"
                                          IsEnabled="True"
                                          SelectionMode="Single"
                                          SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                                          MouseDoubleClick="AppsGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="46" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="App" Width="5*" MinWidth="200" SortMemberPath="Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Left"
                                                                    Background="Transparent"
                                                                    Padding="0,0,7,0"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="Loose name match. Worth a quick check."
                                                                    Visibility="{Binding IsLooseMatch, Converter={StaticResource BoolToVis}}">
                                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Warning}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Name}" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Publisher}"
                                                                   Style="{StaticResource RowSubtext}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Type" Width="92" SortMemberPath="TypeLabel">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TypeLabel}" Value="WinGet">
                                                                            <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding TypeLabel}" Value="Manual">
                                                                            <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding TypeLabel}"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   Margin="7,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn x:Name="AppsCategoryColumn" Header="Category" Binding="{Binding Category}" Width="118" IsReadOnly="True" SortMemberPath="Category" ElementStyle="{StaticResource GridCellText}" />
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" IsReadOnly="True" SortMemberPath="Version" ElementStyle="{StaticResource GridCellText}" />
                                        <DataGridTextColumn x:Name="AppsIdColumn" Header="ID" Binding="{Binding Id}" Width="4*" MinWidth="170" IsReadOnly="True" SortMemberPath="Id" ElementStyle="{StaticResource GridCellMono}" />
                                        <DataGridTextColumn x:Name="AppsNotesColumn" Header="Notes" Binding="{Binding Notes}" Width="4*" MinWidth="90" IsReadOnly="True" SortMemberPath="Notes" ElementStyle="{StaticResource GridCellText}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasApps, Converter={StaticResource InverseBoolToVis}}">
                                    <Image Width="72" Height="72"
                                           Source="Assets/TeaChest.png"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center" />
                                    <TextBlock Text="Nothing in the chest yet"
                                               Style="{StaticResource H2}"
                                               HorizontalAlignment="Center"
                                               Margin="0,14,0,0" />
                                    <TextBlock Text="Scan this PC to see what's installed, or open a manifest you saved earlier."
                                               Style="{StaticResource Subtle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0" />
                                    <Button Content="Scan this PC"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ScanCommand}"
                                            HorizontalAlignment="Center"
                                            Margin="0,16,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Details panel: opened by double-clicking a row, then follows the selection. -->
                        <Border Grid.Column="1"
                                Style="{StaticResource Card}"
                                Width="320"
                                Margin="16,0,0,0"
                                Padding="0"
                                Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="18,14,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Details" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource IconButton}"
                                            Content="&#xE711;"
                                            FontSize="12"
                                            ToolTip="Close details"
                                            AutomationProperties.Name="Close details"
                                            Command="{Binding CloseDetailsCommand}" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="Pick an app in the list to see its details here."
                                           Style="{StaticResource Subtle}"
                                           TextWrapping="Wrap"
                                           Margin="18,8,18,18"
                                           Visibility="{Binding HasSelectedApp, Converter={StaticResource InverseBoolToVis}}" />

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding HasSelectedApp, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Margin="18,4,18,18">
                                        <TextBlock Text="{Binding SelectedApp.Name}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding SelectedDetails}" Margin="0,4,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,12,0,0">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                                        <TextBlock Text="{Binding Value}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="13.5"
                                                                   Margin="0,3,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMono}" Value="True">
                                                                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Margin="0,18,0,0">
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="Open in the Microsoft Store"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,0,0,8"
                                                    Command="{Binding OpenStoreCommand}"
                                                    Visibility="{Binding HasStoreLink, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="See it on winget.run"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,0,0,8"
                                                    Command="{Binding OpenWingetCommand}"
                                                    Visibility="{Binding HasWingetLink, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="Open the install folder"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,0,0,8"
                                                    Command="{Binding OpenFolderCommand}"
                                                    Visibility="{Binding HasInstallFolder, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Install view -->
                <Grid x:Name="InstallView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Install apps" Style="{StaticResource H1}" />
                            <TextBlock Text="Preview the plan, then let WinGet rebuild the selected apps."
                                       Style="{StaticResource Subtle}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="LoadButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Load manifest..."
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanEdit}"
                                    Command="{Binding LoadCommand}" />
                            <Button x:Name="PreviewButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Preview plan"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanEdit}"
                                    Command="{Binding PreviewCommand}" />
                            <Button x:Name="RetryButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="{Binding RetryLabel}"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanRetry}"
                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding RetryCommand}" />
                            <Button x:Name="InstallButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Install selected"
                                    IsEnabled="{Binding CanInstall}"
                                    Command="{Binding InstallCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Active manifest" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ManifestLabel}"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ManifestLabel}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <CheckBox Content="Force reinstall" IsChecked="{Binding ForceReinstall}" IsEnabled="{Binding CanEdit}" Margin="0,0,18,0" />
                                <CheckBox Content="Allow interactive" IsChecked="{Binding AllowInteractive}" IsEnabled="{Binding CanEdit}" Margin="0,0,18,0" />
                                <CheckBox Content="Skip Store" IsChecked="{Binding SkipStore}" IsEnabled="{Binding CanEdit}" Margin="0,0,18,0" />
                                <CheckBox Content="Match scope" IsChecked="{Binding MatchScope}" IsEnabled="{Binding CanEdit}" Margin="0,0,18,0" />
                                <CheckBox Content="Pin versions" IsChecked="{Binding PinVersions}" IsEnabled="{Binding CanEdit}" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SoftCard}" Margin="0,0,0,14" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Subtle}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1"
                                         Height="4"
                                         Maximum="100"
                                         Value="{Binding ProgressValue, Mode=OneWay}"
                                         VerticalAlignment="Center"
                                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <DataGrid x:Name="PlanGrid" ItemsSource="{Binding PlanItems}" MouseDoubleClick="PlanGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Action" Width="96" SortMemberPath="Action">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Action}" Value="Install">
                                                                            <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Action}" Value="Manual">
                                                                            <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Action}"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   Margin="7,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Status" Width="132" SortMemberPath="Status">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding StatusDetail}">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Installing">
                                                                            <Setter Property="Fill" Value="{DynamicResource Info}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                                            <Setter Property="Fill" Value="{DynamicResource Success}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="RebootRequired">
                                                                            <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   Margin="7,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="3*" MinWidth="150" IsReadOnly="True" ElementStyle="{StaticResource GridCellPrimary}" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="78" IsReadOnly="True" ElementStyle="{StaticResource GridCellText}" />
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="4*" MinWidth="110" IsReadOnly="True" ElementStyle="{StaticResource GridCellText}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasPlan, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="No plan yet"
                                               Style="{StaticResource H2}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Preview a plan to see what will be installed, skipped, or handled manually."
                                               Style="{StaticResource Subtle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0" />
                                    <Button Content="Preview plan"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Center"
                                            Margin="0,14,0,0"
                                            Command="{Binding PreviewCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="False" />

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="14,10,14,4">
                                    <TextBlock Text="Activity" Style="{StaticResource Caption}" />
                                    <TextBlock Text="Live WinGet output" Style="{StaticResource Caption}" HorizontalAlignment="Right" Opacity="0.7" />
                                </Grid>
                                <TextBox Grid.Row="1"
                                         x:Name="LogBox"
                                         Text="{Binding LogText, Mode=OneWay}"
                                         Style="{StaticResource LogTextBox}"
                                         TextChanged="LogBox_TextChanged" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="NearbyView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nearby devices" Style="{StaticResource H1}" />
                            <TextBlock Text="Pull the app list straight from your old PC over the local network. No manifest file to copy."
                                       Style="{StaticResource Subtle}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <Button x:Name="ShareButton"
                                Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Content="{Binding ShareButtonText}"
                                VerticalAlignment="Center"
                                Command="{Binding ShareCommand}" />
                    </Grid>

                    <!-- Incoming pairing request (shown on the sharing PC) -->
                    <Border Grid.Row="1"
                            Style="{StaticResource Card}"
                            BorderBrush="{DynamicResource Accent}"
                            Margin="0,0,0,14"
                            Padding="18,14"
                            Visibility="{Binding HasPairingRequest, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Pairing request" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding PairingRequestText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PairingRequestCode}"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{DynamicResource Accent}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,24,0" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Content="Reject" Margin="0,0,8,0" Command="{Binding RejectPairingCommand}" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Codes match, confirm" Command="{Binding ConfirmPairingCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <Border Style="{StaticResource SoftCard}"
                                Background="{DynamicResource WarningSoft}"
                                Margin="0,0,0,14"
                                Padding="14,10"
                                Visibility="{Binding HasNetworkWarning, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding NetworkWarning}"
                                           Foreground="{DynamicResource Warning}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Open network settings"
                                        VerticalAlignment="Center"
                                        Command="{Binding OpenNetworkSettingsCommand}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SoftCard}"
                                Margin="0,0,0,14"
                                Padding="14,10"
                                Visibility="{Binding HasShareStatus, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ShareStatus}" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Devices -->
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="On this network" Style="{StaticResource Caption}" />

                                <Grid Grid.Row="1" Margin="0,10,0,10">
                                    <ListBox x:Name="DevicesList"
                                             ItemsSource="{Binding Devices}"
                                             SelectedItem="{Binding SelectedDevice}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource DeviceItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             MouseDoubleClick="DevicesList_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource AccentSoft}">
                                                        <TextBlock Text="&#xE7F4;"
                                                                   FontFamily="{StaticResource IconFont}"
                                                                   Foreground="{DynamicResource Accent}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource RowSubtext}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            CornerRadius="6"
                                                            Padding="7,2"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentSoft}"
                                                            Visibility="{Binding IsKnown, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Paired" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Looking for PCs with sharing turned on. On the old PC, open Nearby devices and click Share this PC."
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="10,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <StackPanel Grid.Row="2">
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Connect and compare"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding ConnectCommand}" />
                                    <TextBlock Text="Or connect by address" Style="{StaticResource Caption}" Margin="0,16,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="The address shown on the sharing PC, e.g. 192.168.1.20" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryButton}"
                                                Content="Connect"
                                                Margin="8,0,0,0"
                                                Command="{Binding ConnectManualCommand}" />
                                    </Grid>
                                    <TextBlock Text="{Binding LocalAddresses, StringFormat=This PC: {0}}"
                                               Style="{StaticResource Caption}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                                    <TextBlock Text="{Binding ConnectStatus}" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ClientPairingCode}"
                                               FontSize="30"
                                               FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding HasClientPairingCode, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="Cancel"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0"
                                            Command="{Binding CancelConnectCommand}"
                                            Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Comparison -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="16,14,16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Compared with" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding DiffSource}" Style="{StaticResource H2}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding DiffSummary}" Style="{StaticResource Subtle}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource PrimaryButton}"
                                                Content="Install missing apps..."
                                                VerticalAlignment="Center"
                                                IsEnabled="{Binding HasMissing}"
                                                Command="{Binding UseMissingCommand}" />
                                    </Grid>
                                    <ListBox Grid.Row="1"
                                             Style="{StaticResource FilterListBox}"
                                             ItemsSource="{Binding Buckets}"
                                             SelectedItem="{Binding SelectedBucket, Mode=TwoWay}"
                                             ItemContainerStyle="{StaticResource FilterItem}"
                                             DisplayMemberPath="Label"
                                             Margin="16,12,16,10">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedBucket.Items}" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="46" CanUserSort="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="2*" MinWidth="116" IsReadOnly="True" ElementStyle="{StaticResource GridCellPrimary}" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="78" IsReadOnly="True" ElementStyle="{StaticResource GridCellText}" />
                                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="72" IsReadOnly="True" ElementStyle="{StaticResource GridCellText}" />
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="2*" MinWidth="110" IsReadOnly="True" ElementStyle="{StaticResource GridCellMono}" />
                                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" MinWidth="50" IsReadOnly="True" ElementStyle="{StaticResource GridCellText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasDiff, Converter={StaticResource InverseBoolToVis}}">
                                    <Border Width="64" Height="64" CornerRadius="12"
                                            Background="{DynamicResource AccentSoft}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE701;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="26"
                                                   Foreground="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Nothing compared yet"
                                               Style="{StaticResource H2}"
                                               HorizontalAlignment="Center"
                                               Margin="0,14,0,0" />
                                    <TextBlock Text="Pick a device on the left to see which of its apps this PC is missing."
                                               Style="{StaticResource Subtle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,1,0,0"
                    Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               Style="{StaticResource Subtle}"
                               Margin="9,0,16,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding SelectedCount, StringFormat={}{0} selected}"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding TotalCount, StringFormat={}{0} detected}"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <Button Grid.Column="4"
                            Style="{StaticResource DangerButton}"
                            Content="Cancel"
                            Padding="10,5"
                            MinHeight="30"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>



